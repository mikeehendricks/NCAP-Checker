# Copy to .env and adjust. Every value is optional - sane defaults are built in.

# secret | production | development | testing
NCAP_ENV=production

# Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
# NCAP_SECRET_KEY=

# Where the SQLite database, logs, screenshots and browser profiles live.
# NCAP_INSTANCE_DIR=/opt/ncap-checker/instance
# NCAP_DATA_DIR=/opt/ncap-checker/instance/data

# web | scheduler | all
NCAP_ROLE=all

# Bind the scheduler off in the web process if you run separate units.
# NCAP_ENABLE_SCHEDULER=true

# Behind HTTPS, keep this on.
NCAP_SESSION_SECURE=false
NCAP_CSRF_ENABLED=true

# Optional path to a Chromium/Chrome binary (defaults to the Playwright build).
# NCAP_PLAYWRIGHT_EXECUTABLE=/usr/bin/chromium
NCAP_PLAYWRIGHT_HEADLESS=true

# Self-update behaviour: git | manual | disabled
NCAP_UPDATE_MODE=git
NCAP_GIT_REMOTE=origin
NCAP_GIT_BRANCH=main
NCAP_SERVICE_WEB=ncap-web
NCAP_SERVICE_SCHEDULER=ncap-scheduler

NCAP_TIMEZONE=Asia/Manila
NCAP_LOG_LEVEL=INFO
